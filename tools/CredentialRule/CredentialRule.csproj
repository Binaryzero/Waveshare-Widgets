<Project Sdk="Microsoft.NET.Sdk">
  <!-- CI guard for the install-time credential rule (#57). The rule exists twice — in
       tools/validate-widget.js at build time, and in CredentialNames.cs at the install
       boundary — because a package that never met the Node validator still has to be
       refused. Two implementations can drift, and the drift is silent and dangerous in
       one direction: the validator refuses a widget the host then installs anyway.

       Both are checked against the SAME fixture (tools/credential-names.json). This
       probe is the C# half; the validator's own self-test flag is the other. It also
       covers WidgetManifest.CredentialsAreTyped, which is what actually turns a
       flagged name into a refusal. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CredentialRule</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/WaveshareWidgets/Widgets/CredentialNames.cs" />
    <Compile Include="../../src/WaveshareWidgets/Widgets/WidgetManifest.cs" />
  </ItemGroup>
</Project>
