<Project Sdk="Microsoft.NET.Sdk">
  <!-- CI guard for the widget-derived credential store (issue #175).

       A widget's long-lived credential is DPAPI-sealed at rest; the SHORT-lived one it
       buys with that had nowhere to go but localStorage, a plaintext file in the same
       WebView profile — handing back exactly what the sealing withholds. This store
       closes that, and the decisions worth guarding are pure: which scopes and keys are
       accepted, what the caps are, that one widget's bucket is unreachable from another,
       and above all that an unavailable cipher writes NOTHING rather than degrading to
       plaintext. None of that needs Windows, DPAPI or a running shell, so the predicates
       live here and only the message wiring is left to inspection.

       SecretStore's cipher seam is substituted exactly as tools/SecretRoundTrip does it,
       so this exercises the real seal->reveal path rather than a mock of it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WidgetSecretsProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/WaveshareWidgets/Widgets/WidgetSecrets.cs" />
    <Compile Include="../../src/WaveshareWidgets/Widgets/SecretStore.cs" />
    <!-- SecretStore.cs's own dependency closure, the same set tools/SecretRoundTrip
         compiles. Included so this probe exercises the REAL envelope rather than a
         reimplementation of it — the whole point of reusing SecretStore is that there is
         one protection story, and a probe with its own copy of the cipher would be
         asserting something else. -->
    <Compile Include="../../src/WaveshareWidgets/Widgets/WidgetManifest.cs" />
    <Compile Include="../../src/WaveshareWidgets/Widgets/CredentialNames.cs" />
    <Compile Include="../../src/WaveshareWidgets/Widgets/SecretIntents.cs" />
    <Compile Include="../../src/WaveshareWidgets/Widgets/LayoutStore.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
