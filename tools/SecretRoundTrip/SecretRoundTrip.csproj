<Project Sdk="Microsoft.NET.Sdk">
  <!-- CI guard for the `secret` property pipeline (#15): proves, against the REAL
       SecretStore/SecretPolicy source, that a credential is encrypted before it can
       reach layout.json, that the settings editor never receives one back, that a
       masked round-trip keeps the stored value, and that a host without DPAPI fails
       SAFE (previous ciphertext kept, plaintext never written) instead of leaking.
       DPAPI is Windows-only, so the probe substitutes a reversible stand-in cipher
       through SecretStore's internal seam — same assembly, so `internal` is visible. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SecretRoundTrip</AssemblyName>
    <!-- The probe targets plain net8.0 so it runs on the Linux CI host; the DPAPI calls
         it compiles are never reached there (the cipher seam is overridden), and the
         shipping project's own windows-target build validates the platform properly. -->
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/WaveshareWidgets/Widgets/WidgetManifest.cs" />
    <Compile Include="../../src/WaveshareWidgets/Widgets/SecretStore.cs" />
    <!-- The real layout model — including the fact that LayoutSlot carries no
         extension data, which is what keeps `secretsSet` out of layout.json. -->
    <Compile Include="../../src/WaveshareWidgets/Widgets/LayoutStore.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
