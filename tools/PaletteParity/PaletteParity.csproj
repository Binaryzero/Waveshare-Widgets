<Project Sdk="Microsoft.NET.Sdk">
  <!-- The theme palette is derived twice: by PaletteEngine.cs for the panel, and by
       palette.js for the settings window's live preview and per-widget overrides. This
       writes the C# derivation of a fixed battery of themes to a JSON file, and
       tests/harness/paletteparity-run.js derives the same themes in JS and compares every
       token, so the two cannot drift apart. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PaletteParity</AssemblyName>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Plinth/App/PaletteEngine.cs" />
    <!-- ThemeSpec lives in LayoutStore.cs, which needs the rest of this set to compile. -->
    <Compile Include="../../src/Plinth/Widgets/WidgetManifest.cs" />
    <Compile Include="../../src/Plinth/Widgets/RefusalBanner.cs" />
    <Compile Include="../../src/Plinth/Widgets/CredentialNames.cs" />
    <Compile Include="../../src/Plinth/Widgets/SecretStore.cs" />
    <Compile Include="../../src/Plinth/Widgets/SecretIntents.cs" />
    <Compile Include="../../src/Plinth/Widgets/LayoutStore.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
