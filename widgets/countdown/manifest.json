{
  "id": "ws.stock.countdown",
  "name": "Countdown",
  "author": "Plinth",
  "version": "1.1.1",
  "description": "Counts down to a date and time you set — biggest-unit readout, progress since you configured it, and a celebration when the moment arrives.",
  "min_api_version": 1,
  "supported_slots": [
    "quarter",
    "half"
  ],
  "properties": [
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "default": "Countdown"
    },
    {
      "name": "target",
      "label": "Target date & time",
      "type": "text",
      "placeholder": "2026-12-24 18:00",
      "default": ""
    },
    {
      "name": "bgStyle",
      "label": "Background",
      "type": "select",
      "options": [
        "solid",
        "glass",
        "transparent"
      ],
      "default": "solid"
    }
  ]
}
