{
  "id": "ws.stock.media",
  "name": "Now Playing",
  "author": "Plinth",
  "version": "1.5.1",
  "description": "Now-playing media with album art, progress bar, and touch transport controls.",
  "min_api_version": 1,
  "supported_slots": [
    "half",
    "full"
  ],
  "properties": [
    {
      "name": "bgStyle",
      "label": "Background",
      "type": "select",
      "options": [
        "solid",
        "glass",
        "transparent"
      ],
      "default": "solid"
    },
    {
      "name": "titleSize",
      "label": "Title size",
      "type": "slider",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100,
      "group": "Text"
    },
    {
      "name": "artistSize",
      "label": "Artist size",
      "type": "slider",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100,
      "group": "Text"
    },
    {
      "name": "albumSize",
      "label": "Album size",
      "type": "slider",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100,
      "group": "Text"
    },
    {
      "name": "timeSize",
      "label": "Time size",
      "type": "slider",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100,
      "group": "Text"
    }
  ]
}
