{
  "id": "ws.stock.homeassistant",
  "name": "Home Assistant",
  "author": "Waveshare Widgets",
  "version": "1.0.0",
  "description": "Entity states from Home Assistant with touch control for lights and switches. Locks and covers stay display-only until you arm them, and then need a long press.",
  "min_api_version": 1,
  "supported_slots": ["half", "full"],
  "properties": [
    {
      "name": "baseUrl",
      "label": "Home Assistant address",
      "type": "text",
      "default": "",
      "placeholder": "http://homeassistant.local:8123"
    },
    {
      "name": "accessToken",
      "label": "Long-lived access token",
      "type": "secret",
      "placeholder": "Profile → Security → Long-lived access tokens"
    },
    {
      "name": "entities",
      "label": "Entities",
      "type": "list",
      "itemLabel": "entity",
      "fields": [
        { "key": "entity", "label": "Entity ID", "type": "text", "placeholder": "light.kitchen" },
        { "key": "label", "label": "Name", "type": "text", "placeholder": "Kitchen" },
        { "key": "control", "label": "Locks & covers", "type": "text", "placeholder": "blank = show only · allow = long-press to control" }
      ],
      "default": []
    },
    {
      "name": "refreshSeconds",
      "label": "Refresh every (seconds)",
      "type": "number",
      "min": 5,
      "max": 600,
      "step": 5,
      "default": 20
    },
    {
      "name": "bgStyle",
      "label": "Background",
      "type": "select",
      "options": ["solid", "glass", "transparent"],
      "default": "solid"
    }
  ]
}
