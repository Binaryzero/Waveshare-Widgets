{
  "id": "ws.stock.gpu",
  "name": "GPU Monitor",
  "author": "Plinth",
  "version": "1.4.2",
  "description": "GPU load ring with temperature, clock and VRAM readouts.",
  "min_api_version": 1,
  "supported_slots": [
    "quarter",
    "half"
  ],
  "properties": [
    {
      "name": "loadSensorId",
      "label": "Load Sensor",
      "type": "sensor",
      "sensor_type": "Load",
      "default": ""
    },
    {
      "name": "tempSensorId",
      "label": "Temperature Sensor",
      "type": "sensor",
      "sensor_type": "Temperature",
      "default": ""
    },
    {
      "name": "titleSize",
      "label": "Title size",
      "type": "slider",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100,
      "group": "Text"
    },
    {
      "name": "valueSize",
      "label": "Value size",
      "type": "slider",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100,
      "group": "Text"
    },
    {
      "name": "labelSize",
      "label": "Label size",
      "type": "slider",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100,
      "group": "Text"
    },
    {
      "name": "hintSize",
      "label": "Hint size",
      "type": "slider",
      "min": 50,
      "max": 200,
      "step": 5,
      "default": 100,
      "group": "Text"
    }
  ]
}
