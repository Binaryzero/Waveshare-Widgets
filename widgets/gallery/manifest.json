{
  "id": "ws.stock.gallery",
  "name": "Gallery",
  "author": "Waveshare Widgets",
  "version": "1.1.0",
  "description": "Slideshow of your own photos and videos. Drop files into the media folder (Settings → Open media folder) — images crossfade, videos play through with sound off. New files are picked up automatically.",
  "min_api_version": 1,
  "supported_slots": ["quarter", "half", "full"],
  "properties": [
    { "name": "order", "label": "Play order", "type": "select", "options": ["shuffle", "name"], "default": "shuffle" },
    { "name": "dwell", "label": "Seconds per photo", "type": "slider", "min": 4, "max": 120, "step": 1, "default": 10 },
    { "name": "maxVideoSeconds", "label": "Max video length (seconds)", "type": "slider", "min": 10, "max": 300, "step": 10, "default": 120 },
    { "name": "fit", "label": "Fit", "type": "select", "options": ["cover", "contain"], "default": "cover" },
    { "name": "showName", "label": "Show file name", "type": "select", "options": ["on", "off"], "default": "off" },
    { "name": "bgStyle", "label": "Background", "type": "select", "options": ["solid", "glass", "transparent"], "default": "solid" },
    { "name": "captionSize", "label": "Caption size", "type": "slider", "min": 50, "max": 200, "step": 5, "default": 100, "group": "Text" }
  ]
}
