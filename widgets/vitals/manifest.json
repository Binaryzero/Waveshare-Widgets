{
  "id": "ws.stock.vitals",
  "name": "Vitals",
  "author": "Plinth",
  "version": "1.1.3",
  "description": "A gentle self-care HUD where water, eyes, posture and stretch meters drain while you sit at the PC and a pixel pet's mood tracks the one you've neglected most.",
  "min_api_version": 1,
  "supported_slots": [
    "quarter",
    "half",
    "full"
  ],
  "properties": [
    {
      "name": "petName",
      "label": "Pet name",
      "type": "text",
      "default": "Pip",
      "placeholder": "Pip"
    },
    {
      "name": "pace",
      "label": "Pace",
      "type": "select",
      "options": [
        "gentle",
        "standard",
        "brisk"
      ],
      "default": "standard"
    },
    {
      "name": "quiet",
      "label": "Night quiet (23–07)",
      "type": "select",
      "options": [
        "on",
        "off"
      ],
      "default": "on"
    },
    {
      "name": "water",
      "label": "Water meter",
      "type": "select",
      "options": [
        "on",
        "off"
      ],
      "default": "on"
    },
    {
      "name": "eyes",
      "label": "Eyes meter",
      "type": "select",
      "options": [
        "on",
        "off"
      ],
      "default": "on"
    },
    {
      "name": "posture",
      "label": "Posture meter",
      "type": "select",
      "options": [
        "on",
        "off"
      ],
      "default": "on"
    },
    {
      "name": "stretch",
      "label": "Stretch meter",
      "type": "select",
      "options": [
        "on",
        "off"
      ],
      "default": "on"
    }
  ]
}
