{
  "id": "ws.stock.forecast7",
  "name": "7-Day Forecast",
  "author": "Plinth",
  "version": "1.4.3",
  "description": "Week-ahead outlook from Open-Meteo: seven days of condition, high/low and precipitation chance for any city — no API key. Inspired by DGM Previsión 7 días from the Xenon gallery.",
  "min_api_version": 1,
  "supported_slots": [
    "half",
    "full"
  ],
  "properties": [
    {
      "name": "location",
      "label": "Location",
      "type": "location",
      "default": "Madrid"
    },
    {
      "name": "units",
      "label": "Units",
      "type": "select",
      "options": [
        "celsius",
        "fahrenheit"
      ],
      "default": "celsius"
    },
    {
      "name": "bgStyle",
      "label": "Background",
      "type": "select",
      "options": [
        "solid",
        "glass",
        "transparent"
      ],
      "default": "solid"
    }
  ]
}
