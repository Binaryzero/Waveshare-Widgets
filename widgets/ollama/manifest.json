{
  "id": "ws.stock.ollama",
  "name": "Ollama",
  "author": "Plinth",
  "version": "1.1.3",
  "description": "What Ollama actually has resident on the GPU right now: each loaded model, the VRAM it holds, and how long until it unloads. Pairs with the GPU widget.",
  "min_api_version": 1,
  "supported_slots": ["quarter", "half", "full"],
  "properties": [
    {
      "name": "baseUrl",
      "label": "Ollama address",
      "type": "text",
      "default": "http://localhost:11434",
      "placeholder": "http://localhost:11434"
    },
    {
      "name": "refreshSeconds",
      "label": "Refresh every (seconds)",
      "type": "number",
      "min": 5,
      "max": 300,
      "step": 5,
      "default": 15
    }
  ]
}
